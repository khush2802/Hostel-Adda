# Copy to .env for local development. Never commit .env (it's in .gitignore).
# In production, set these in your hosting provider's environment settings.

# Session signing and session-store encryption: at least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

# MongoDB Atlas connection string for a database user limited to this app's database.
ATLASDB_URL=

# Mapbox public token (geocoding and the listing map).
MAP_TOKEN=

# Cloudinary account (listing image uploads).
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
